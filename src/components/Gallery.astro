---
import { Image } from "astro:assets";
import { byCategory } from "../utils/gallery";
import { withBase } from "../utils/url";
import Lightbox from "./Lightbox.astro";

const featured = [
  byCategory("exterior")[0],
  byCategory("kitchen")[0],
  byCategory("fence")[0],
].filter(Boolean);
---

<section class="section section-soft" id="gallery">
  <div class="wrap">
    <div class="section-head fade-up">
      <p class="eyebrow">Recent Work</p>
      <h2>A look at recent projects.</h2>
      <p>
        A few before-and-after shots from exterior, cabinet, and fence jobs
        we've completed for Pierce County homes.
      </p>
    </div>
    <div class="gal-grid">
      {
        featured.map((photo) => (
          <div class="gal-card fade-up">
            <Image
              src={photo.image}
              alt={photo.alt}
              class="gal-photo"
              widths={[400, 800]}
              sizes="(max-width: 880px) 100vw, 33vw"
            />
          </div>
        ))
      }
    </div>
    <div style="margin-top:36px;text-align:center;">
      <a href={withBase("/gallery")} class="btn btn-ghost">See full gallery</a>
    </div>
  </div>
</section>

<Lightbox />
