---
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/TopNav.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileCTA from "../components/MobileCTA.astro";
import PageHero from "../components/PageHero.astro";
import PageCTA from "../components/PageCTA.astro";
import { SITE } from "../config/site";

const services = [
  {
    title: "Walls & Ceilings",
    desc: "Full room repaints with proper prep — patching, sanding, and priming — so the finish looks clean, not just fresh paint over old flaws.",
    icon: `<rect x="3" y="3" width="18" height="18" rx="1"/><path d="M3 15l5-5 4 4 5-6 4 4"/>`,
  },
  {
    title: "Trim & Baseboards",
    desc: "Crisp lines at every baseboard, window casing, and door frame, masked carefully so trim color never bleeds onto walls or flooring.",
    icon: `<rect x="2" y="3" width="20" height="4" rx="1"/><rect x="2" y="10" width="20" height="4" rx="1"/><rect x="2" y="17" width="20" height="4" rx="1"/>`,
  },
  {
    title: "Doors & Closets",
    desc: "Interior doors and closet interiors get the same careful prep and finish as the rest of the room, inside and out.",
    icon: `<rect x="3" y="2" width="18" height="20" rx="1"/><circle cx="16" cy="12" r="1.5" fill="currentColor"/>`,
  },
  {
    title: "Accent Walls",
    desc: "Single-wall color changes, done cleanly with sharp edges — a fast way to update a room without repainting everything.",
    icon: `<path d="M3 21l4-1 11-11-3-3L4 17l-1 4z"/><path d="M14 6l3 3"/>`,
  },
  {
    title: "Ceilings & Popcorn Texture",
    desc: "Flat ceiling coats, including careful cut-in around fixtures and vents, matched to the rest of the room.",
    icon: `<path d="M3 8h18M6 8v12M12 8v12M18 8v12"/><path d="M3 8l3-4h12l3 4"/>`,
  },
  {
    title: "Furniture & Flooring Protection",
    desc: "Every room is fully covered before we start — furniture moved and wrapped, floors covered, and fixtures masked off.",
    icon: `<path d="M7 16.5c0 1.38 2.24 2.5 5 2.5s5-1.12 5-2.5"/><path d="M12 7v5"/><path d="M8 9l4-4 4 4"/>`,
  },
];

const included = [
  "Furniture moved to center of room and fully covered",
  "Floors, fixtures, and hardware masked before any paint is applied",
  "Patching and sanding of nail holes, dents, and drywall imperfections",
  "Spot-prime on repaired areas and any bare drywall",
  "Two finish coats of paint in your chosen sheen",
  "Daily cleanup — no tools, no tape left behind",
  "Final walkthrough with you before we close out",
];
---

<Layout
  title={`Interior Painting | ${SITE.name}`}
  description="Professional interior painting in Pierce County. Walls, trim, ceilings, and doors, painted room by room. Free estimates."
>
  <TopNav currentPage="interior" />
  <Header />

  <PageHero
    eyebrow="Interior Painting"
    heading="Every room,<br />done with care."
    body="From a single accent wall to a full-home repaint — WK Painting Services handles every interior job with the same careful prep and the same experienced crew."
  >
    <div class="hero-actions">
      <a href={SITE.estimateHref} class="btn btn-cta">Get a Free Estimate</a>
      <a href={SITE.phoneHref} class="btn btn-ghost">Call {SITE.phone}</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <div class="section-head fade-up">
        <p class="eyebrow">What we paint</p>
        <h2>Every room, handled.</h2>
        <p>
          We scope each project in detail up front, so nothing gets missed once
          work begins.
        </p>
      </div>
      <div class="svc-grid svc-grid--3col">
        {
          services.map((s) => (
            <div class="svc-card fade-up">
              <svg
                class="svc-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                set:html={s.icon}
              />
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="wrap">
      <div class="content-split">
        <div class="fade-up">
          <p class="eyebrow">What's included</p>
          <h2>Every job includes these — not as add-ons.</h2>
          <ul class="checklist">
            {
              included.map((item) => (
                <li>
                  <svg
                    class="check-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M9 11l3 3L22 4" />
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="fade-up">
          <div class="pricing-card">
            <p class="pricing-card-eyebrow">Free Estimate</p>
            <h3>Get a written quote for your project</h3>
            <p class="pricing-note">
              Every estimate is free and provided in writing before any work
              begins — no obligation, no pressure.
            </p>
            <a href={SITE.estimateHref} class="btn btn-cta"
              >Request a Free Estimate</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <PageCTA
    variant="cta"
    heading="Ready to refresh your interior?"
    body="We schedule estimates within 2–3 days. No obligation, no pressure, and a color consult is always included."
  >
    <a href={SITE.estimateHref} class="btn btn-dark">Get My Free Estimate</a>
  </PageCTA>

  <Footer />
  <MobileCTA />
</Layout>
