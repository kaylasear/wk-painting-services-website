---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/TopNav.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileCTA from "../components/MobileCTA.astro";
import PageHero from "../components/PageHero.astro";
import PageCTA from "../components/PageCTA.astro";
import { SITE } from "../config/site";
import { byCategory } from "../utils/gallery";
import { withBase } from "../utils/url";

const kitchenPhotos = byCategory("kitchen");

const services = [
  {
    title: "Cabinet Doors & Drawers",
    desc: "Every door and drawer front is removed, labeled, and sprayed off-site or in a controlled area for a smooth, factory-level finish.",
    icon: `<rect x="4" y="3" width="16" height="18" rx="1"/><path d="M4 11h16"/><circle cx="8" cy="7" r="0.6" fill="currentColor"/><circle cx="8" cy="16" r="0.6" fill="currentColor"/>`,
  },
  {
    title: "Boxes & Frames",
    desc: "Cabinet boxes and face frames are cleaned, deglossed, and coated in place with careful masking of counters, floors, and appliances.",
    icon: `<rect x="3" y="4" width="18" height="16" rx="1"/><path d="M3 10h18"/>`,
  },
  {
    title: "Islands & Built-ins",
    desc: "Kitchen islands, pantries, and built-in cabinetry are matched to the rest of the kitchen for a consistent, cohesive look.",
    icon: `<path d="M3 21h18"/><rect x="6" y="9" width="12" height="12" rx="1"/><path d="M9 9V5a3 3 0 0 1 6 0v4"/>`,
  },
  {
    title: "Hardware Removal & Reinstall",
    desc: "Hinges, pulls, and knobs are removed before painting and reinstalled after — or upgraded to new hardware if you'd like a refresh.",
    icon: `<circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8"/>`,
  },
  {
    title: "Spray-Finish Process",
    desc: "We spray rather than brush cabinets for an even, durable coat that resists chipping better than a roller or brush finish.",
    icon: `<path d="M3 12h4l3-3 4 4 3-3h4"/><circle cx="19" cy="6" r="1.5" fill="currentColor"/>`,
  },
  {
    title: "Color Matching & Consult",
    desc: "Not sure what color fits your kitchen? We help you choose a finish that works with your counters, floors, and existing fixtures.",
    icon: `<path d="M12 3a9 9 0 1 0 0 18c1.5 0 2-1 2-2 0-.6-.3-1-.6-1.4-.3-.4-.6-.8-.6-1.3 0-1 .8-1.8 1.8-1.8H17a3 3 0 0 0 3-3c0-5-3.5-8.5-8-8.5z"/><circle cx="7.5" cy="10.5" r="1" fill="currentColor"/><circle cx="10.5" cy="7" r="1" fill="currentColor"/>`,
  },
];

const included = [
  "Removal, labeling, and reinstall of all doors, drawers, and hardware",
  "Full degreasing and deglossing before any primer goes on",
  "Sanding and filling of dents, dings, or old hardware holes",
  "Bonding primer built for cabinetry, not wall paint",
  "Sprayed finish coats for a smooth, durable, factory-style result",
  "Masking and protection of counters, floors, and appliances",
  "Final walkthrough with you before we close out",
];
---

<Layout
  title={`Cabinet Painting | ${SITE.name}`}
  description="Professional kitchen cabinet painting in Pierce County. Spray-finished doors, boxes, and drawers for a factory-smooth result. Free estimates."
>
  <TopNav currentPage="cabinet" />
  <Header />

  <PageHero
    eyebrow="Cabinet Painting"
    heading="Cabinets that look<br />replaced, not repainted."
    body="From a single kitchen island to a full cabinet re-color, WK Painting Services sprays every door, drawer, and frame for a smooth, lasting finish."
  >
    <div class="hero-actions">
      <a href={SITE.estimateHref} class="btn btn-cta">Get a Free Estimate</a>
      <a href={SITE.phoneHref} class="btn btn-ghost">Call {SITE.phone}</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <div class="section-head fade-up">
        <p class="eyebrow">What we do</p>
        <h2>Every step, handled with care.</h2>
        <p>
          Cabinets take more prep than walls — we scope each kitchen in detail
          before any paint goes on.
        </p>
      </div>
      <div class="svc-grid svc-grid--3col">
        {
          services.map((s) => (
            <div class="svc-card fade-up">
              <svg
                class="svc-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                set:html={s.icon}
              />
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="wrap">
      <div class="content-split">
        <div class="fade-up">
          <p class="eyebrow">What's included</p>
          <h2>Every job includes these — not as add-ons.</h2>
          <ul class="checklist">
            {
              included.map((item) => (
                <li>
                  <svg
                    class="check-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M9 11l3 3L22 4" />
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="fade-up">
          <div class="pricing-card">
            <p class="pricing-card-eyebrow">Free Estimate</p>
            <h3>Get a written quote for your project</h3>
            <p class="pricing-note">
              Every estimate is free and provided in writing before any work
              begins — no obligation, no pressure.
            </p>
            <a href={SITE.estimateHref} class="btn btn-cta"
              >Request a Free Estimate</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head fade-up">
        <p class="eyebrow">Recent Work</p>
        <h2>Kitchen cabinet projects.</h2>
        <p>A sample of recent cabinet painting jobs.</p>
      </div>
      <div class="gal-grid">
        {
          kitchenPhotos.map((photo) => (
            <div class="gal-card fade-up">
              <Image
                src={photo.image}
                alt={photo.alt}
                class="gal-photo"
                widths={[400, 800]}
                sizes="(max-width: 880px) 100vw, 33vw"
              />
            </div>
          ))
        }
      </div>
      <div style="margin-top:36px;text-align:center;">
        <a href={withBase("/gallery")} class="btn btn-ghost">See full gallery</a
        >
      </div>
    </div>
  </section>

  <PageCTA
    variant="cta"
    heading="Ready to update your kitchen?"
    body="We schedule estimates within 2–3 days. No obligation, no pressure, and a color consult is always included."
  >
    <a href={SITE.estimateHref} class="btn btn-dark">Get My Free Estimate</a>
  </PageCTA>

  <Footer />
  <MobileCTA />
</Layout>
